# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real secrets.

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# local Homebrew PostgreSQL: your Mac username, no password
DATABASE_URL=postgres://your_mac_username@localhost:5432/sceill
# Hosted database (e.g. Aiven): paste its Service URI, which ends in ?sslmode=require,
# and also its CA certificate so the server is verified:
# DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google / Apple login (optional; email + password works without them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Bank account shown to customers after they place an order (bank transfer)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=

# Email is NOT needed right now: "forgot password" works without sending any email.
# The sender code is still in app/lib/mail.ts if you add emails later (order updates, or
# verifying the owner in the password reset). Any SMTP provider works. Leave this empty otherwise.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="SCEILL <no-reply@your-domain.com>"
